# ---- Server / auth -------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Generate with:  python -m app.hashpw
APP_PASSWORD_HASH=
# Optional; auto-generated into data/.session_secret if empty
SESSION_SECRET=
# Set true when serving over HTTPS (reverse proxy)
COOKIE_SECURE=false
TIMEZONE=Asia/Kolkata

# ---- Polite crawling -----------------------------------------------------
USER_AGENT=SEOCRMBot/1.0 (+https://itskhay.com/bot; polite crawler; contact: you@example.com)
CRAWL_DELAY_SEC=2.0          # min seconds between requests to one host (robots Crawl-delay wins if larger)
OWN_SITE_DELAY_SEC=0.5       # delay when crawling a client's own site (audit)
GLOBAL_CONCURRENCY=8
MAX_RESPONSE_BYTES=2000000

# ---- Link graph / metrics -----------------------------------------------
GRAPH_OWN_PAGES=60           # pages crawled on the client's own site
GRAPH_EXPAND_DOMAINS=30      # external domains snowballed per metrics run
GRAPH_PAGES_PER_DOMAIN=6
SEARXNG_URL=                 # e.g. http://127.0.0.1:8888 (self-hosted search; strongly recommended)

# ---- Backlink agent ------------------------------------------------------
SUBMIT_DELAY_MIN_SEC=20
SUBMIT_DELAY_MAX_SEC=60
RUN_MAX_MINUTES=90
STRICT_TARGET_DEDUPE=true    # never use the same target URL twice for a client, whatever the anchor
ALLOW_SAME_DOMAIN=false      # at most one backlink per referring domain per client
INCLUDE_GLOBAL_TARGETS=true  # also accept worldwide-friendly targets with no country signal
MAX_SUBMIT_ATTEMPTS=3
VERIFY_BACKOFF_HOURS=2,24,72,168,336
PLAYWRIGHT_HEADLESS=true

# ---- Audit ---------------------------------------------------------------
AUDIT_MAX_PAGES=200
AUDIT_LINK_CHECK_MAX=300
AUDIT_BROWSER_SAMPLES=3      # pages measured with headless Chromium (load, LCP); 0 disables

# ---- Google Sheet --------------------------------------------------------
# service_account | oauth | apps_script | none
SHEETS_BACKEND=service_account
SHEET_NAME=SEO
SHEET_ID=                    # optional; skips name lookup
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_OAUTH_TOKEN_FILE=./secrets/oauth-token.json
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# ---- Scheduler -----------------------------------------------------------
CATCHUP_ON_START=true        # run a schedule that was missed while the app was down
ALLOW_PRIVATE_HOSTS=false    # leave false; true only for local testing
